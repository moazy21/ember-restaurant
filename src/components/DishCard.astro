---
import type { Dish } from '../data/site.ts';
interface Props { d: Dish; }
const { d } = Astro.props;
---
<a href={`/dishes/${d.slug}`} class="dish-card group bg-coal rounded-[20px] overflow-hidden border border-line block">
  <div class="aspect-[4/3] overflow-hidden bg-char">
    <img src={d.image} alt={d.title} loading="lazy" decoding="async" width="800" height="600" class="w-full h-full object-cover" />
  </div>
  <div class="p-5">
    <div class="flex items-center justify-between gap-2 text-[12px] font-bold">
      <span class="border border-cream/15 text-cream/70 px-2.5 py-1 rounded-full">{d.category}</span>
      <span class="tabular-nums text-ember font-extrabold">${d.price}</span>
    </div>
    <h3 class="font-display text-[24px] leading-snug mt-3">{d.title}</h3>
    <p class="text-sm text-cream/60 mt-1 leading-relaxed">{d.excerpt}</p>
  </div>
</a>
