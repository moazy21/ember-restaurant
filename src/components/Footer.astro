---
import { navLinks, site } from '../data/site.ts';
import Icon from './Icon.astro';
---
<footer class="bg-coal border-t border-line mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-[28px] tracking-[0.12em]">EMBER</p>
      <p class="mt-3 text-sm text-cream/60 max-w-[32ch] leading-relaxed">Wood-fired kitchen in RiNo. One oak oven, one open hearth, no gas.</p>
      <p class="mt-4 text-sm flex items-center gap-1.5"><span class="inline-flex gap-0.5 text-ember" aria-hidden="true"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></span><span class="sr-only">Rated</span> {site.rating} from {site.reviewCount} guests</p>
    </div>
    <nav aria-label="Footer">
      <p class="text-[12px] uppercase tracking-[0.16em] text-cream/45 mb-4">Explore</p>
      <ul class="space-y-2.5 text-[15px]">
        {navLinks.map(l => <li><a class="text-cream/85 hover:underline underline-offset-4" href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="text-[12px] uppercase tracking-[0.16em] text-cream/45 mb-4">Visit</p>
      <p class="text-sm leading-relaxed text-cream/85">{site.address}</p>
      <ul class="mt-3 text-sm space-y-1.5 text-cream/60">
        {site.hours.map(h => <li class="flex justify-between gap-4"><span>{h[0]}</span><span>{h[1]}</span></li>)}
      </ul>
    </div>
    <div>
      <p class="text-[12px] uppercase tracking-[0.16em] text-cream/45 mb-4">Reserve</p>
      <a href={site.phoneHref} class="text-lg font-bold hover:underline underline-offset-4">{site.phone}</a>
      <div class="mt-4">
        <a href="/reserve" class="inline-block bg-ember text-char font-extrabold px-6 py-3 rounded-full text-sm hover:bg-cream transition">Book a table</a>
      </div>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 flex flex-col sm:flex-row gap-2 justify-between text-xs text-cream/45">
      <span>© 2026 EMBER Wood-Fired Kitchen. Demonstration site with sample photography and pricing.</span>
      <span><a href="/reserve" class="underline underline-offset-2">Privacy</a> · <a href="/reserve" class="underline underline-offset-2">Terms</a></span>
    </div>
  </div>
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
