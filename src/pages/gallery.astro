---
import BaseLayout from '../layouts/BaseLayout.astro';
const items = [
  ['The dining room','Low light, real conversation','https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=700&q=80&auto=format&fit=crop'],
  ['The hearth counter','Six seats, closest to the fire','https://images.unsplash.com/photo-1552566626-52f8b828add9?w=700&q=80&auto=format&fit=crop'],
  ['From the oven','Flatbreads at full heat','https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=700&q=80&auto=format&fit=crop'],
  ['Sunday roast','Family style, whole table','https://images.unsplash.com/photo-1544025162-d76694265947?w=700&q=80&auto=format&fit=crop'],
  ['The bar','Smoked pours, low intervention wine','https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?w=700&q=80&auto=format&fit=crop'],
  ['Something sweet','Burnt, on purpose','https://images.unsplash.com/photo-1551024506-0bccd828d307?w=700&q=80&auto=format&fit=crop'],
];
---
<BaseLayout title="Gallery" description="The room, the hearth, the plates. A look inside EMBER.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-16">
    <h1 class="font-display text-4xl sm:text-5xl lg:text-[58px] lg:leading-[1.05]">Fire looks good on us.</h1>
    <p class="mt-3 text-cream/60 max-w-[55ch] text-[15px]">Sample photography for layout. Come see the real thing on Blake Street.</p>
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {items.map(r => (
        <figure class="bg-coal border border-line rounded-[20px] overflow-hidden">
          <img src={r[2]} alt={r[0]} loading="lazy" decoding="async" width="700" height="525" class="aspect-[4/3] w-full object-cover" />
          <figcaption class="p-5"><p class="font-display text-[22px]">{r[0]}</p><p class="text-sm text-cream/55">{r[1]}</p></figcaption>
        </figure>
      ))}
    </div>
    <div class="mt-10 bg-ember text-char rounded-[22px] p-8 text-center">
      <h2 class="font-display text-3xl sm:text-4xl">Better in person. Obviously.</h2>
      <a href="/reserve" class="mt-4 inline-block bg-char text-cream font-extrabold px-8 py-3 rounded-full text-sm">Reserve a table</a>
    </div>
  </section>
</BaseLayout>
