---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { faqs } from '../data/site.ts';
const tiers = [
  { name: 'Ember Table', price: 95, perks: ['4 courses, monthly menu','Welcome pour from the bar','Zero corkage on club nights'] },
  { name: 'Ember Plus', price: 145, popular: true, perks: ['4 courses + full pairing','First pours of new bottles','Priority weekend booking','One guest seat quarterly'] },
  { name: 'Ember Room', price: 380, perks: ['Chef counter for two, monthly','Off-menu hearth course','Annual whole-animal dinner','First refusal on events'] },
];
---
<BaseLayout title="Tasting Club" description="Monthly four course tasting menu with pairings. Join the EMBER Tasting Club.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-16 text-center">
    <h1 class="font-display text-4xl sm:text-5xl lg:text-[58px] lg:leading-[1.05]">Same fire, longer evening.</h1>
    <p class="mt-3 text-cream/60 max-w-[52ch] mx-auto">One seating a month built around whatever the oven is excited about. Members eat first, pay less, cancel anytime.</p>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-5 text-left items-stretch">
      <div class="bg-coal border border-line rounded-[22px] p-7">
        <p class="font-bold">Single visit</p>
        <p class="font-display text-4xl mt-2 tabular-nums">À la carte</p>
        <ul class="mt-4 text-sm space-y-2.5 text-cream/65">
          <li class="flex gap-2"><span class="mt-0.5 text-ember"><Icon name="check" size={14} /></span>Full menu, any night</li>
          <li class="flex gap-2"><span class="mt-0.5 text-ember"><Icon name="check" size={14} /></span>Hearth counter for walk-ins</li>
          <li class="flex gap-2"><span class="mt-0.5 text-ember"><Icon name="check" size={14} /></span>Bar list to 11pm</li>
        </ul>
        <a href="/reserve" class="mt-6 block text-center border border-cream/20 text-cream font-bold py-3 rounded-full text-sm">Book a table</a>
      </div>
      {tiers.map(t => (
        <div class={`rounded-[22px] p-7 border ${t.popular ? 'bg-ember text-char border-ember relative' : 'bg-coal border-line'}`}>
          {t.popular && <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-cream text-char text-xs font-extrabold px-4 py-1 rounded-full whitespace-nowrap">Most popular</span>}
          <p class="font-bold">{t.name}</p>
          <p class="font-display text-5xl mt-2 tabular-nums">${t.price}<span class="text-base font-sans">/seat</span></p>
          <ul class={`mt-4 text-sm space-y-2.5 ${t.popular ? 'text-char/80 font-medium' : 'text-cream/65'}`}>
            {t.perks.map(p => <li class="flex gap-2"><span class="mt-0.5"><Icon name="check" size={14} /></span>{p}</li>)}
          </ul>
          <a href="/reserve" class={`mt-6 block text-center font-extrabold py-3 rounded-full text-sm ${t.popular ? 'bg-char text-cream' : 'bg-ember text-char'}`}>Join {t.name}</a>
        </div>
      ))}
    </div>
  </section>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-14">
    <h2 class="font-display text-2xl sm:text-3xl text-center">Club questions</h2>
    <div class="mt-6 border-t border-line">
      {faqs.slice(0,4).map(f => <div class="py-4 border-b border-line"><p class="font-bold">{f.q}</p><p class="mt-2 text-sm text-cream/60">{f.a}</p></div>)}
    </div>
  </section>
</BaseLayout>
