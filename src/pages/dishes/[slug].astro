---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { dishes } from '../../data/site.ts';
export function getStaticPaths() {
  return dishes.map(d => ({ params: { slug: d.slug } }));
}
const { slug } = Astro.params;
const d = dishes.find(x => x.slug === slug) ?? dishes[0];
const related = dishes.filter(x => x.slug !== d.slug && x.category === d.category).slice(0,3);
---
<BaseLayout title={d.title} description={`${d.title}, $${d.price}. ${d.excerpt}`}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-16 grid gap-8 lg:grid-cols-2 items-start">
    <div class="rounded-[22px] overflow-hidden aspect-[4/3] bg-coal">
      <img src={d.image} alt={d.title} width="1000" height="750" decoding="async" class="w-full h-full object-cover" />
    </div>
    <div>
      <a href="/menu" class="text-sm font-bold underline underline-offset-4 text-cream">Full menu</a>
      <p class="mt-4 text-xs font-bold uppercase tracking-[0.14em] text-cream/50">{d.category}</p>
      <h1 class="font-display text-4xl sm:text-5xl mt-2">{d.title}</h1>
      <p class="mt-3 text-cream/65">{d.excerpt}</p>
      <p class="mt-4 font-display text-4xl text-ember tabular-nums">${d.price}</p>
      <ul class="mt-6 space-y-2.5">
        {d.details.map(b => <li class="flex gap-3 text-[15px] text-cream/80"><span class="w-6 h-6 shrink-0 grid place-items-center rounded-full bg-ember/20 text-ember"><Icon name="check" size={13} /></span>{b}</li>)}
      </ul>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/reserve" class="bg-ember text-char font-extrabold px-7 py-3.5 rounded-full">Reserve a table</a>
        <a href="/tasting-club" class="border border-cream/20 text-cream font-bold px-7 py-3.5 rounded-full">Tasting Club</a>
      </div>
      <p class="mt-4 text-xs text-cream/45">Menu changes with the market. Allergies, tell us when you book.</p>
    </div>
  </section>
  {related.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 py-14">
      <h2 class="font-display text-2xl sm:text-3xl">From the same fire</h2>
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-5">
        {related.map(r => <a href={`/dishes/${r.slug}`} class="bg-coal border border-line rounded-[20px] overflow-hidden block"><img src={r.image} alt={r.title} loading="lazy" decoding="async" width="600" height="375" class="aspect-[16/10] w-full object-cover" /><div class="p-5"><p class="font-display text-[22px]">{r.title}</p><p class="text-sm text-cream/55 tabular-nums">${r.price}</p></div></a>)}
      </div>
    </section>
  )}
</BaseLayout>
