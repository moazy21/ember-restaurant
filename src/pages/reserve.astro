---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.ts';
---
<BaseLayout title="Reserve a table" description="Book a table at EMBER. Dining room, hearth counter, or the ember room for 14.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-16 grid gap-10 lg:grid-cols-2">
    <div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-[54px] lg:leading-[1.05]">Two minutes to a good evening.</h1>
      <p class="mt-3 text-cream/60">Dining room books out most weekends. Bar and hearth counter are held for walk-ins.</p>
      <div class="mt-6 bg-coal border border-line rounded-[20px] p-6 text-sm space-y-2">
        <p class="font-bold text-cream">{site.address}</p>
        {site.hours.map(h => <p class="flex justify-between text-cream/60"><span>{h[0]}</span><span>{h[1]}</span></p>)}
        <a href={site.phoneHref} class="block font-bold text-lg pt-2 text-cream">{site.phone}</a>
      </div>
    </div>
    <div class="bg-coal border border-line rounded-[22px] p-6 sm:p-8 h-fit" style="box-shadow: 0 14px 36px -16px rgba(0,0,0,.6)">
      <form id="bookForm" class="grid gap-4" novalidate>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="text-sm font-bold text-cream">Full name</label>
            <input id="name" required class="mt-1.5 w-full bg-char border border-cream/20 text-cream rounded-xl px-4 py-3 min-h-[48px] focus:outline-none placeholder:text-cream/35" placeholder="Jane Doe" />
          </div>
          <div>
            <label for="phone" class="text-sm font-bold text-cream">Phone</label>
            <input id="phone" type="tel" required class="mt-1.5 w-full bg-char border border-cream/20 text-cream rounded-xl px-4 py-3 min-h-[48px] focus:outline-none placeholder:text-cream/35" placeholder="(303) 555-0000" />
          </div>
        </div>
        <div class="grid sm:grid-cols-3 gap-4">
          <div>
            <label for="date" class="text-sm font-bold text-cream">Date</label>
            <input id="date" type="date" required class="mt-1.5 w-full bg-char border border-cream/20 text-cream rounded-xl px-4 py-3 min-h-[48px] focus:outline-none" />
          </div>
          <div>
            <label for="time" class="text-sm font-bold text-cream">Time</label>
            <select id="time" class="mt-1.5 w-full bg-char border border-cream/20 text-cream rounded-xl px-4 py-3 min-h-[48px]">
              <option>17:30</option><option>18:00</option><option>18:30</option><option selected>19:00</option><option>19:30</option><option>20:00</option><option>20:30</option><option>21:00</option>
            </select>
          </div>
          <div>
            <label for="party" class="text-sm font-bold text-cream">Party</label>
            <select id="party" class="mt-1.5 w-full bg-char border border-cream/20 text-cream rounded-xl px-4 py-3 min-h-[48px]">
              <option>1</option><option selected>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7+ (we will call)</option>
            </select>
          </div>
        </div>
        <div>
          <label for="seat" class="text-sm font-bold text-cream">Seating</label>
          <select id="seat" class="mt-1.5 w-full bg-char border border-cream/20 text-cream rounded-xl px-4 py-3 min-h-[48px]">
            <option>Dining room</option><option>Hearth counter (walk-in only)</option><option>Bar</option><option>Ember room (14 guests)</option>
          </select>
        </div>
        <div>
          <label for="msg" class="text-sm font-bold text-cream">Occasions, allergies <span class="font-normal text-cream/50">(optional)</span></label>
          <textarea id="msg" rows="3" class="mt-1.5 w-full bg-char border border-cream/20 text-cream rounded-xl px-4 py-3 focus:outline-none placeholder:text-cream/35" placeholder="Anniversary, nut allergy, quiet corner..."></textarea>
        </div>
        <p id="formError" class="hidden text-sm font-bold text-red-300 bg-red-950/60 border border-red-900 rounded-xl px-4 py-3">Please add your name, a phone number, and a date.</p>
        <button type="submit" id="submitBtn" class="bg-ember text-char font-extrabold py-4 rounded-full hover:bg-cream transition min-h-[52px]">Request this table</button>
        <p class="text-xs text-cream/45 text-center">We confirm every request by text. No card required under 6 guests.</p>
      </form>
      <div id="formSuccess" class="hidden text-center py-10">
        <p class="w-14 h-14 mx-auto grid place-items-center rounded-full bg-ember/20 text-ember"><Icon name="check" size={22} /></p>
        <h2 class="font-display text-3xl mt-4">Request received.</h2>
        <p class="text-sm text-cream/60 mt-2">We will text you within the hour to confirm your table.</p>
      </div>
    </div>
  </section>
<script>
  const form = document.getElementById('bookForm') as HTMLFormElement;
  const date = document.getElementById('date') as HTMLInputElement;
  date.min = new Date().toISOString().split('T')[0];
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
    const err = document.getElementById('formError')!;
    const ok = name.length > 1 && phone.length >= 7 && date.value !== '';
    if (!ok) { err.classList.remove('hidden'); return; }
    err.classList.add('hidden');
    const btn = document.getElementById('submitBtn') as HTMLButtonElement;
    btn.textContent = 'Sending…'; btn.disabled = true;
    setTimeout(() => {
      form.classList.add('hidden');
      document.getElementById('formSuccess')!.classList.remove('hidden');
    }, 900);
  });
</script>
</BaseLayout>
